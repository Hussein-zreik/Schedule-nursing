rules_version = '2';

// Firestore security rules for the RN Rotating Schedule.
//
// Paste these into: Firebase console -> Firestore Database -> Rules -> Publish.
// See SECURITY.md for the full setup.
//
// What these rules enforce:
//
//   1. A REAL account. Anonymous sign-in is explicitly rejected, so "being
//      signed in" can no longer be obtained by anyone with one API call.
//   2. MEMBERSHIP per unit. Each schedule document carries a `members` list of
//      account UIDs; only those accounts can read or write that unit. Knowing
//      the unit code is no longer enough.
//   3. NO LISTING. Only `get` is allowed, never `list`. This is the important
//      one: `allow read` would also permit `list`, which lets anyone download
//      every unit's roster in a single query.
//   4. Nothing else in the database is reachable at all.

service cloud.firestore {
  match /databases/{database}/documents {

    // A real account — anonymous sessions do not count.
    function signedIn() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /schedules/{unitCode} {

      // UIDs allowed to use this unit (missing field -> empty list)
      function memberList() {
        return resource.data.get('members', []);
      }
      function isMember() {
        return signedIn() && request.auth.uid in memberList();
      }
      // A unit created before membership existed has no members yet. It may be
      // claimed ONCE, by a signed-in account that writes itself into the list.
      // After that it is owned and this branch can never apply again.
      function unclaimed() {
        return memberList().size() == 0;
      }
      // The writer must keep themselves in the members list, so a unit can
      // never be written into a state that locks its own members out.
      function keepsSelf() {
        return request.auth.uid in request.resource.data.get('members', []);
      }

      // Read a single document only. `list` is never granted, so the schedules
      // collection cannot be enumerated. A signed-in account may see whether a
      // unit code exists (needed to create a new unit) but not its contents.
      // `unclaimed()` is the one-time migration window: a unit created before
      // membership existed has no owner yet, so the first real account can open
      // it and claim it. Once claimed this branch can never apply again.
      allow get: if signedIn() && (resource == null || isMember() || unclaimed());

      allow create: if signedIn() && keepsSelf();
      allow update: if signedIn() && keepsSelf() && (isMember() || unclaimed());
      allow delete: if isMember();
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
